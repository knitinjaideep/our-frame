# Copy this file to .env.local and fill in your values.
# Only NEXT_PUBLIC_* values are exposed to the browser.
# Never put Supabase secret/service-role keys here.

NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>

# Vercel production placeholder:
# NEXT_PUBLIC_API_BASE=https://api.ourframe.nitinkotcherlakota.com
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>

# Optional, useful for canonical URLs later:
# NEXT_PUBLIC_SITE_URL=https://ourframe.nitinkotcherlakota.com

# Never add Supabase secret/service-role keys to frontend env vars.
