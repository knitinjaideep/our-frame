# ─────────────────────────────────────────────────────────────
# Our Frame — Backend Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Legacy single-user callback (still used by /auth/start for backward compat)
GOOGLE_OAUTH_REDIRECT=http://localhost:8000/auth/callback

# Phase 1 — per-user Drive connect callback
# Add this URI in Google Cloud Console → OAuth credentials → Authorized redirect URIs
GOOGLE_DRIVE_OAUTH_REDIRECT=http://localhost:8000/api/drive/callback

# ── Legacy single-user Drive root (kept for backward compat) ──
# Find the folder ID in the Drive URL: drive.google.com/drive/folders/<ID>
GOOGLE_DRIVE_ROOT_FOLDER=your-google-drive-folder-id

# ── App ───────────────────────────────────────────────────────
FRONTEND_ROOT=http://localhost:3000
DATABASE_URL=sqlite:///./data/ourframe.db
DEBUG=false

# Local derivatives use disk. Production should use Supabase Storage after the
# storage adapter is enabled.
MEDIA_STORAGE_BACKEND=local
MEDIA_CACHE_ROOT=./data/media-cache

# ── Vercel production placeholders ────────────────────────────
# FRONTEND_ROOT=https://ourframe.nitinkotcherlakota.com
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# MEDIA_STORAGE_BACKEND=supabase

# ── Session ───────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-in-production-use-a-long-random-string

# Session lifetime in seconds (default 7 days = 604800)
SESSION_TTL_SECONDS=604800

# ── Token encryption ──────────────────────────────────────────
# Encrypts Drive OAuth tokens stored in the database.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, tokens are base64-only (local dev only — NOT safe for production).
TOKEN_ENCRYPTION_KEY=

# ── Supabase ──────────────────────────────────────────────────
# Server-side only. Never put service role keys in frontend env vars.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_MEDIA_BUCKET=our-frame-media-cache

# ── Production Google OAuth redirect placeholders ─────────────
# GOOGLE_OAUTH_REDIRECT=https://our-frame-api.vercel.app/auth/callback
# GOOGLE_DRIVE_OAUTH_REDIRECT=https://our-frame-api.vercel.app/api/drive/callback

# ── AI (optional) ─────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# AI_ENABLED=true
